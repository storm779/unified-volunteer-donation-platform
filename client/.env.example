# demo runs locally without external accounts; must match server APP_MODE.
VITE_APP_MODE=demo
VITE_API_URL=http://localhost:5000/api

# For Firebase mode, set VITE_APP_MODE=firebase and fill your Firebase web app config.
# Firebase web config is public project identification, never an Admin service account.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
