# The local demo works without a .env file or external credentials.
# Demo access is restricted to loopback and forbidden in production.
APP_MODE=demo
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: demo | razorpay-test. Defaults to demo in demo mode,
# and razorpay-test in Firebase mode. Never use a live Razorpay key here.
# Set demo explicitly to skip Razorpay while using real Firebase auth and data.
# Simulated payments require loopback hosting and a non-production environment.
# PAYMENT_MODE=demo

# To use Firebase Authentication + Firestore, set APP_MODE=firebase.
# Option A: service account JSON file path (keep this file outside the repository).
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/private/firebase-service-account.json
# Option B: copy these fields from a Firebase service account.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required for PAYMENT_MODE=razorpay-test. Only the key ID is sent to the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional stable demo session signing secret, at least 32 characters.
# When omitted, a fresh secret is generated at startup and old demo sessions expire.
# DEMO_JWT_SECRET=

